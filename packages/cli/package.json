{
  "name": "@gilons-ai/atelier",
  "version": "0.0.7",
  "description": "The planning companion for AI coding agents. Maps your product across code, docs, design, and conversations and hands production-grade specs to Claude Code, Codex, Cursor, or any agent. Deterministic; never calls an LLM itself. Auto-installs agents into Claude Code's .claude/.",
  "keywords": [
    "atelier",
    "planning",
    "spec-driven",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "cli",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "atelier": "./dist/atelier.js"
  },
  "files": [
    "dist/atelier.js",
    "dist/macos-helper",
    "macos-helper",
    "scripts/compile-macos-helper.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && npm run build:macos-helper && npm run bundle",
    "build:macos-helper": "./scripts/compile-macos-helper.sh",
    "bundle": "node scripts/bundle.mjs",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "node --test tests/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@atelier/core": "*"
  },
  "license": "MIT",
  "author": "gilons",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gilons/atelier.git",
    "directory": "packages/cli"
  }
}
