{
  "name": "@gilons/atelier",
  "version": "0.0.1",
  "description": "Atelier — a planning companion for the spec-driven era. An org-level CLI that maps your product across code, docs, design, and conversations and hands specs to your coding agent.",
  "keywords": [
    "atelier",
    "planning",
    "spec-driven",
    "ai-agents",
    "claude-code",
    "cli",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "atelier": "./dist/atelier.js"
  },
  "files": [
    "dist/atelier.js",
    "dist/macos-helper",
    "macos-helper",
    "scripts/compile-macos-helper.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && npm run build:macos-helper && npm run bundle",
    "build:macos-helper": "./scripts/compile-macos-helper.sh",
    "bundle": "node scripts/bundle.mjs",
    "clean": "tsc --build --clean && rm -rf dist",
    "test": "node --test tests/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@atelier/core": "*"
  },
  "license": "MIT",
  "author": "gilons",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gilons/atelier.git",
    "directory": "packages/cli"
  }
}
